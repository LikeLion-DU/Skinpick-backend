# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

OPENAI_API_KEY=sk-...

# ★ 한 번만 생성해서 고정한다. 매번 새로 만들면 재기동할 때마다 전원 로그아웃된다.
#   openssl rand -base64 48
JWT_SECRET=

SPRING_PROFILES_ACTIVE=local
TEST_ACCOUNT_ENABLED=true

# ★ API_BASE_URL 과 반드시 같은 호스트. localhost 로 두면 에뮬레이터에서 사진만 안 뜬다.
STORAGE_BASE_URL=http://10.0.2.2:8080/uploads

DB_USER=skinplate
DB_PASSWORD=skinplate
