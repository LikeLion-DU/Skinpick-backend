# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

OPENAI_API_KEY=sk-...

# --- AI 모델 ---
# 🚨 계정 일일 한도가 두 모델 다 50회다(2026-08-17 실측). 전체 플로우 1회가 4요청이라
#    하루 12회면 막힌다. 크레딧이 남아 있어도 막힌다 — 티어는 결제한 누적 금액으로
#    오르지 크레딧 사용량으로 오르지 않는다. $5 한 번 결제하면 Tier 1 이 되고
#    일일 한도가 사라진다(TPM 도 60,000 → 500,000).
#    한도 확인: https://platform.openai.com/account/rate-limits

# 기본값 gpt-5.6-luna. gpt-4o 대비 TPM 6배(10,000 → 60,000) · 비용 1/8 이라 골랐다.
# gpt-4o 는 이 조직에서 RPM 3 이라 짧은 시간에 3건이 들어오면 전부 429 다.
#
# ★ 롤백 — 실기기에서 같은 사진 반복 시 점수가 심하게 흔들리면 이 한 줄로 되돌린다.
#   gpt-4o 는 temperature=0.2 를 쓸 수 있어 재현성이 더 좋다(대신 위 RPM 3 을 감수한다).
#   요청 규약(max_completion_tokens · reasoning_effort)은 코드가 모델 이름으로 알아서 가른다.
# OPENAI_MODEL=gpt-4o

# 피부 분석 전용 예산. 다른 호출(음식·문장 800 / 인사이트 1200, 25초)과 따로 둔다.
# 상한이지 목표가 아니다 — 실측 출력은 442~554 토큰, 지연은 2.5~3.5초다.
# ★ 타임아웃 상한은 28 이고 코드가 강제한다(넘기면 28 로 조정 + 경고). 재시도 대기까지
#   포함한 전체 마감이 값+2 라 클라이언트 상한(32초) 안에 들어와야 한다.
# SKIN_MAX_TOKENS=1400
# SKIN_TIMEOUT_SECONDS=28

# 리포트(주간 AI 코멘트) 전용 타임아웃. 분석과 달리 짧게 끊는다 — 리포트는 하루에도
# 여러 번 여는 조회 화면이고, 문장 생성이 실패해도 점수·영양·고민은 그대로 나간다.
# 재시도 대기까지 포함한 전체 마감은 값 + 2 다(기본 8 → 최악 10초).
# 실측 지연이 이 값을 넘기기 시작하면 문장이 조용히 사라지므로 로그에서 확인한다.
# REPORT_TIMEOUT_SECONDS=8

# ★ 한 번만 생성해서 고정한다. 매번 새로 만들면 재기동할 때마다 전원 로그아웃된다.
#   openssl rand -base64 48
JWT_SECRET=

SPRING_PROFILES_ACTIVE=local
TEST_ACCOUNT_ENABLED=true


# --- DB : 로컬 Docker (docker compose up -d postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skinplate
DB_USER=skinplate
DB_PASSWORD=skinplate

# --- DB : 배포 (Supabase) ---
# 위 DB_HOST·DB_PORT·DB_NAME 대신 DB_JDBC_URL 하나를 쓴다.
# 값은 Supabase 대시보드 Connect > Session pooler > Type: JDBC 에서 복사하되,
# ?user=...&password=... 쿼리 파라미터는 떼고 아래 두 변수로 옮긴다.
# ★ Transaction pooler(6543) 를 쓰면 안 된다 — Flyway 가 세션 advisory lock 을 쓰기 때문에 마이그레이션이 깨진다.
# ★ Direct connection(db.<ref>.supabase.co) 도 안 된다 — IPv4 애드온 없이는 IPv6 전용이라 VM 에서 붙지 않는다.
# DB_JDBC_URL=jdbc:postgresql://aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=
