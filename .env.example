# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

OPENAI_API_KEY=sk-...

# ★ 한 번만 생성해서 고정한다. 매번 새로 만들면 재기동할 때마다 전원 로그아웃된다.
#   openssl rand -base64 48
JWT_SECRET=

SPRING_PROFILES_ACTIVE=local
TEST_ACCOUNT_ENABLED=true


# --- DB : 로컬 Docker (docker compose up -d postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skinplate
DB_USER=skinplate
DB_PASSWORD=skinplate

# --- DB : 배포 (Supabase) ---
# 위 DB_HOST·DB_PORT·DB_NAME 대신 DB_JDBC_URL 하나를 쓴다.
# 값은 Supabase 대시보드 Connect > Session pooler > Type: JDBC 에서 복사하되,
# ?user=...&password=... 쿼리 파라미터는 떼고 아래 두 변수로 옮긴다.
# ★ Transaction pooler(6543) 를 쓰면 안 된다 — Flyway 가 세션 advisory lock 을 쓰기 때문에 마이그레이션이 깨진다.
# ★ Direct connection(db.<ref>.supabase.co) 도 안 된다 — IPv4 애드온 없이는 IPv6 전용이라 VM 에서 붙지 않는다.
# DB_JDBC_URL=jdbc:postgresql://aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=
